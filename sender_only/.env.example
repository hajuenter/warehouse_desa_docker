# Database OpenSID Desa (yang sudah ada)
DB_HOST=<IP_HOST_DB_OPENSID_DESA>
DB_PORT=3306
DB_USER=<username_db>
DB_PASSWORD=<password_db>
DB_NAME=<nama_database_opensid>

# Data dari tabel config OpenSID
DESA_KODE=<kode_desa_dari_tabel_config>
WEBHOOK_TOKEN=<app_key_dari_tabel_config>

# Receiver
WEBHOOK_URL=http://<IP_SERVER_RECEIVER>:3000/api/webhook
WEBHOOK_TIMEOUT=10
MAX_RETRY=5
POLL_INTERVAL=3
